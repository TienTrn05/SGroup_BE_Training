PORT=3000
NODE_ENV=development

# Set the complete Neon connection string, including its SSL query parameters.
# When set, DATABASE_URL takes precedence over DB_* below.
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password
DB_NAME=sgroup

# Replace with two different random secrets, each at least 32 bytes.
JWT_SECRET=replace-with-a-random-access-secret-at-least-32-bytes
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-bytes
# Lifetimes in seconds.
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Only needed for image uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
